ARG APP_BASE_IMAGE=agentsmith-app-base:local
ARG NODE_RUNTIME_IMAGE=node:24.14.1-bookworm
ARG MC_IMAGE=minio/mc:latest

FROM ${MC_IMAGE} AS mc-bin

FROM ${APP_BASE_IMAGE} AS build

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY src ./src
COPY public ./public
COPY messages ./messages
COPY packages ./packages
COPY scripts ./scripts
COPY infra ./infra
COPY assets ./assets
COPY components.json ./
COPY next.config.ts ./
COPY next-env.d.ts ./
COPY postcss.config.js ./
COPY tailwind.config.js ./
COPY tsconfig.json ./

RUN npx next build --no-lint

FROM ${NODE_RUNTIME_IMAGE} AS runtime

ARG JUICEFS_VERSION=1.3.0

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY infra/vendor/juicefs /tmp/juicefs-dist
COPY --from=mc-bin /usr/bin/mc /usr/local/bin/mc

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  set -eux; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    fuse3 \
    procps \
  ; \
  arch="$(dpkg --print-architecture)"; \
  case "${arch}" in \
    amd64) juicefs_arch="amd64" ;; \
    arm64) juicefs_arch="arm64" ;; \
    *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
  esac; \
  archive="/tmp/juicefs-dist/juicefs-${JUICEFS_VERSION}-linux-${juicefs_arch}.tar.gz"; \
  test -f "${archive}"; \
  tar -xzf "${archive}" -C /tmp; \
  install -m 0755 /tmp/juicefs /usr/local/bin/juicefs; \
  rm -rf /tmp/juicefs /tmp/juicefs-dist

COPY --from=build /app /app

EXPOSE 20000 3001

CMD ["bash", "-lc", "echo 'Use service-specific command overrides for api or web' && sleep infinity"]

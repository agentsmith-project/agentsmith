# AgentSmith Environment Variables

# ============================================================
# API Configuration
# ============================================================

# Backend API Base URL (development, include /api/v1)
NEXT_PUBLIC_API_BASE=http://localhost:20000/api/v1

# Use MSW for API mocking
# - true: mock mode
# - false: real Keycloak + API mode
NEXT_PUBLIC_USE_MSW=false

# Bypass authentication (development only - for testing)
NEXT_PUBLIC_BYPASS_AUTH=false

# ============================================================
# i18n Configuration
# ============================================================

# Default locale (fallback if user locale not available)
NEXT_PUBLIC_DEFAULT_LOCALE=en-US

# Supported locales
NEXT_PUBLIC_LOCALES=en-US,zh-CN

# ============================================================
# Keycloak OIDC (Production)
# ============================================================

# Keycloak server URL
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:18080/realms

# Keycloak realm
NEXT_PUBLIC_KEYCLOAK_REALM=mbos

# Keycloak client ID
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=agentsmith

# ============================================================
# Feature Flags
# ============================================================

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# Enable service worker (PWA)
NEXT_PUBLIC_SERVICE_WORKER=false

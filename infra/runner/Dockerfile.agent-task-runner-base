ARG NODE_BASE_IMAGE=node:24.14.1-bookworm
FROM ${NODE_BASE_IMAGE}

ARG CODEX_VERSION=0.117.0
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  set -eux; \
  if [ -n "${HTTP_PROXY:-}" ]; then echo "Acquire::http::Proxy \"${HTTP_PROXY}\";" > /etc/apt/apt.conf.d/99proxy; fi; \
  if [ -n "${HTTPS_PROXY:-}" ]; then echo "Acquire::https::Proxy \"${HTTPS_PROXY}\";" >> /etc/apt/apt.conf.d/99proxy; fi; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    bubblewrap \
    build-essential \
    ca-certificates \
    curl \
    git \
    openssh-client \
    procps \
    python3 \
    python3-pip \
    tini \
  ; \
  rm -f /etc/apt/apt.conf.d/99proxy

RUN --mount=type=cache,target=/root/.npm \
  set -eux; \
  export http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" no_proxy="${NO_PROXY:-}"; \
  npm install -g "@openai/codex@${CODEX_VERSION}"; \
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY no_proxy

WORKDIR /opt/agentsmith

COPY package.json package-lock.json ./
COPY packages/agent-runner/package.json packages/agent-runner/package.json
COPY packages/agent-runner/tsconfig.json packages/agent-runner/tsconfig.json
COPY packages/agent-task-runner/package.json packages/agent-task-runner/package.json
COPY packages/agent-task-runner/tsconfig.json packages/agent-task-runner/tsconfig.json

RUN --mount=type=cache,target=/root/.npm \
  set -eux; \
  npm ci --workspace @mbos/agent-runner --workspace @mbos/agent-task-runner --include-workspace-root=false --include=dev --no-audit --no-fund; \
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'cd /opt/agentsmith' \
    'exec npm run dev -w @mbos/agent-task-runner -- "$@"' \
    > /usr/local/bin/agent-task-runner; \
  chmod +x /usr/local/bin/agent-task-runner

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["agent-task-runner"]

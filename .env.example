# See https://github.com/nodejs/node/issues/35511
reflectedGlobalProperty:
  - fetch
  - globalThis
  - Headers
  - Request
  - Response
  - DOMException
  - ReadableStream
  - FormData

# Trusted domains for markdown image rendering (comma-separated)
# Only images from these domains will be rendered in markdown content.
# This is a security measure to prevent XSS attacks via malicious image sources.
#
# IMPORTANT: Safe default - if not set, NO images will be rendered.
# Configure this only with domains you explicitly trust.
#
# Examples:
# - Single domain: NEXT_PUBLIC_TRUSTED_IMAGE_DOMAINS=cdn.yourcompany.com
# - Multiple domains: NEXT_PUBLIC_TRUSTED_IMAGE_DOMAINS=cdn.yourcompany.com,images.trusted-cdn.com,assets.cdn.example.com
#
# Note: Subdomains are automatically included (e.g., 'example.com' allows 'cdn.example.com')
NEXT_PUBLIC_TRUSTED_IMAGE_DOMAINS=

ARG NODE_BASE_IMAGE=node:22-bookworm
FROM ${NODE_BASE_IMAGE}

ARG JUICEFS_VERSION=1.3.0
ARG CODEX_VERSION=0.110.0
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

COPY infra/vendor/juicefs /tmp/juicefs-dist

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  set -eux; \
  if [ -n "${HTTP_PROXY:-}" ]; then echo "Acquire::http::Proxy \"${HTTP_PROXY}\";" > /etc/apt/apt.conf.d/99proxy; fi; \
  if [ -n "${HTTPS_PROXY:-}" ]; then echo "Acquire::https::Proxy \"${HTTPS_PROXY}\";" >> /etc/apt/apt.conf.d/99proxy; fi; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    fuse3 \
    git \
    openssh-client \
    procps \
    python3 \
    python3-pip \
    tini \
  ; \
  rm -f /etc/apt/apt.conf.d/99proxy

RUN --mount=type=cache,target=/root/.npm \
  set -eux; \
  arch="$(dpkg --print-architecture)"; \
  case "${arch}" in \
    amd64) juicefs_arch="amd64" ;; \
    arm64) juicefs_arch="arm64" ;; \
    *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
  esac; \
  archive="/tmp/juicefs-dist/juicefs-${JUICEFS_VERSION}-linux-${juicefs_arch}.tar.gz"; \
  test -f "${archive}"; \
  tar -xzf "${archive}" -C /tmp; \
  install -m 0755 /tmp/juicefs /usr/local/bin/juicefs; \
  rm -rf /tmp/juicefs /tmp/juicefs-dist

RUN --mount=type=cache,target=/root/.npm \
  set -eux; \
  export http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" no_proxy="${NO_PROXY:-}"; \
  npm install -g "@openai/codex@${CODEX_VERSION}"; \
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY no_proxy

WORKDIR /opt/agent-runner

RUN --mount=type=cache,target=/root/.npm \
  set -eux; \
  printf '%s\n' \
    '{' \
    '  "name": "agent-codex-runner-image",' \
    '  "private": true,' \
    '  "type": "module",' \
    '  "scripts": {' \
    '    "start": "tsx src/index.ts"' \
    '  },' \
    '  "dependencies": {' \
    '    "ws": "^8.18.3"' \
    '  },' \
    '  "devDependencies": {' \
    '    "tsx": "^4.20.6"' \
    '  }' \
    '}' \
    > /opt/agent-runner/package.json; \
  npm install --no-audit --no-fund; \
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'cd /opt/agent-runner' \
    'exec npm run start -- "$@"' \
    > /usr/local/bin/agent-runner; \
  chmod +x /usr/local/bin/agent-runner

ENV MBOS_AGENT_BUILTIN_SKILLS_DIR=/opt/agent-runner/builtin-skills

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["agent-runner"]

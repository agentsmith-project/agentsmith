# Copy one of the dedicated templates instead of editing this file directly:
# - local frontend/backend development: `.env.local.example` -> `.env.local`
# - local-manual real runtime: `.env.local-manual.example` -> `.env.local-manual`
# - backend-real verification: `.env.backend-real.example` -> `.env.backend-real`
#
# This file stays as a valid `.env`-format reference for shared public runtime flags.

# Trusted domains for markdown image rendering (comma-separated)
# Only images from these domains will be rendered in markdown content.
# This is a security measure to prevent XSS attacks via malicious image sources.
#
# IMPORTANT: Safe default - if not set, NO images will be rendered.
# Configure this only with domains you explicitly trust.
#
# Examples:
# - Single domain: NEXT_PUBLIC_TRUSTED_IMAGE_DOMAINS=cdn.yourcompany.com
# - Multiple domains: NEXT_PUBLIC_TRUSTED_IMAGE_DOMAINS=cdn.yourcompany.com,images.trusted-cdn.com,assets.cdn.example.com
#
# Note: Subdomains are automatically included (e.g., 'example.com' allows 'cdn.example.com')
NEXT_PUBLIC_TRUSTED_IMAGE_DOMAINS=

# Local frontend/backend development uses `.env.local.example`.
# Canonical local API base includes `/api/v1`.
NEXT_PUBLIC_API_BASE=http://localhost:20000/api/v1
NEXT_PUBLIC_USE_MSW=false
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:18080/realms
NEXT_PUBLIC_KEYCLOAK_REALM=mbos
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=agentsmith

# SSE Ticket Migration (Epic B1)
# -----------------------------------------------------------------------------
# Enable ticket-based authentication for SSE connections (security improvement)
# When enabled, JWT tokens are NO LONGER exposed in SSE URLs
#
# Migration phases (see docs/plans/next-release-product-roadmap-prd-v1.md):
# - Day 1-2: Set to "false" (dual-stack available, ticket endpoint exists but not enforced)
# - Day 3-5: Set to "true" with PERCENTAGE at 10 -> 30 -> 60 (grayscale rollout)
# - Day 6-7: Set to "true" with PERCENTAGE at 100 (full switch)
# - Post-release: Keep at "true" with PERCENTAGE at 100
#
# IMPORTANT: When ENABLED=true, if ticket endpoint fails, SSE will NOT fall back to JWT.
# This is intentional - JWT in URL is a security vulnerability.
NEXT_PUBLIC_SSE_TICKET_ENABLED=false

# Percentage of users who should use ticket-based authentication (0-100)
# Used for grayscale rollout during migration
# - 0: No users use ticket (fallback to JWT)
# - 10: 10% of users use ticket
# - 100: All users use ticket
# The rollout is deterministic per user based on user ID hash
NEXT_PUBLIC_SSE_TICKET_PERCENTAGE=0

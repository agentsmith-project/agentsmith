ARG NODE_BASE_IMAGE=node:24.14.1-bookworm
FROM ${NODE_BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  set -eux; \
  if [ -n "${HTTP_PROXY:-}" ]; then echo "Acquire::http::Proxy \"${HTTP_PROXY}\";" > /etc/apt/apt.conf.d/99proxy; fi; \
  if [ -n "${HTTPS_PROXY:-}" ]; then echo "Acquire::https::Proxy \"${HTTPS_PROXY}\";" >> /etc/apt/apt.conf.d/99proxy; fi; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    tini \
  ; \
  rm -f /etc/apt/apt.conf.d/99proxy

WORKDIR /opt/agentsmith

COPY package.json package-lock.json ./
COPY packages/agent-runner/package.json packages/agent-runner/package.json
COPY packages/agent-runner/tsconfig.json packages/agent-runner/tsconfig.json
COPY packages/chat-llm-runner/package.json packages/chat-llm-runner/package.json
COPY packages/chat-llm-runner/tsconfig.json packages/chat-llm-runner/tsconfig.json

RUN --mount=type=cache,target=/root/.npm \
  set -eux; \
  npm ci --workspace @mbos/agent-runner --workspace @mbos/chat-llm-runner --include-workspace-root=false --include=dev --no-audit --no-fund; \
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'cd /opt/agentsmith' \
    'exec npm run dev -w @mbos/chat-llm-runner -- "$@"' \
    > /usr/local/bin/chat-runner; \
  chmod +x /usr/local/bin/chat-runner

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["chat-runner"]

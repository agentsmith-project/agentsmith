#
# Cluster deploy operator input.
# This file defines stable deployment truth for the real-cluster release line.
# Real values should live in:
#   .infra/cluster-deploy/site.env
# and on the target host:
#   $HOME/agentsmith/cluster-deploy/config/site.env
#
CLUSTER_DEPLOY_MODE=semi-auto

POSTGRES_USER=mbos
POSTGRES_PASSWORD=mbos_dev_password
POSTGRES_DB=mbos
POSTGRES_PORT=15432

MONGO_ROOT_USERNAME=mbos
MONGO_ROOT_PASSWORD=mbos_dev_password
MONGO_DB=mbos
MONGO_PORT=17017

REDIS_PORT=16379

MINIO_ROOT_USER=mbos
MINIO_ROOT_PASSWORD=mbos_dev_password
MINIO_BUCKET=mbos-dev
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=18080
KEYCLOAK_REALM=mbos
KEYCLOAK_CLIENT_ID=agentsmith

PUBLIC_WEB_BASE_URL=https://mbos.imotion.ai
PUBLIC_API_BASE_URL=https://mbos.imotion.ai/api
PUBLIC_KEYCLOAK_BASE_URL=https://mbos.imotion.ai/keycloak
COMPOSE_INTERNAL_API_BASE_URL=http://api:20000
COMPOSE_INTERNAL_KEYCLOAK_BASE_URL=http://keycloak:8080
COMPOSE_INTERNAL_UNIVERSAL_PROXY_BASE_URL=http://universal-proxy:8080
HOST_LOCAL_POSTGRES_HOST=127.0.0.1
HOST_LOCAL_POSTGRES_PORT=15432
HOST_LOCAL_MINIO_ENDPOINT=http://127.0.0.1:19000
CLIENT_PUBLIC_POSTGRES_HOST=mbos.imotion.ai
CLIENT_PUBLIC_POSTGRES_PORT=15432
CLIENT_PUBLIC_MINIO_ENDPOINT=http://mbos.imotion.ai:19000

# Real cluster external dependency truth.
# These values must be reachable from pods in the cluster.
K8S_EXTERNAL_POSTGRES_HOST=mbos.imotion.ai
K8S_EXTERNAL_POSTGRES_PORT=15432
K8S_EXTERNAL_MINIO_HOST=mbos.imotion.ai
K8S_EXTERNAL_MINIO_PORT=19000
K8S_EXTERNAL_API_BASE_URL=https://mbos.imotion.ai/api

API_PORT=20000
WEB_PORT=3001

SYSTEM_ADMIN_USERNAME=mbos-admin
SYSTEM_ADMIN_PASSWORD=mbos-admin
# Leave empty to derive from PUBLIC_WEB_BASE_URL automatically.
# Set true only when the public web entry uses https.
SYSTEM_ADMIN_SESSION_COOKIE_SECURE=

INTEGRATION_PUBLIC_WEB_BASES=https://mbos.imotion.ai
INTEGRATION_DEV_ADMIN_USERNAME=dev-admin
INTEGRATION_DEV_ADMIN_PASSWORD=dev-admin-123
INTEGRATION_USER_USERNAME=integration-user
INTEGRATION_USER_PASSWORD=integration-user-123
INTEGRATION_MEMBER_USERNAME=integration-member
INTEGRATION_MEMBER_PASSWORD=integration-member-123

MBOS_DEFAULT_WORKSPACE_ID=ws_default
MBOS_DEFAULT_WORKSPACE_NAME="Default Workspace"
MBOS_DEFAULT_WORKSPACE_ADMIN_EMAIL=dev-admin@example.com
PRESET_PROJECT_NAME="Demo Project"
PRESET_CREDENTIAL_NAME=minimax-shared-key
PRESET_ANTHROPIC_ENDPOINT_NAME=minimax-anthropic
PRESET_OPENAI_ENDPOINT_NAME=minimax-openai
PRESET_EXTERNAL_AGENT_NAME=demo-external-agent
PRESET_INTERNAL_AGENT_NAME=demo-internal-agent

SYSTEM_WORKSPACE_REGISTRY_MODE=mongo

SANDBOX_SERVICE_KEY=agentsmith-sandbox-key
SANDBOX_MANAGER_INGRESS_CLASS_NAME=nginx
SANDBOX_MANAGER_INGRESS_HOST=sandbox-manager.mbos.imotion.ai
# Leave SANDBOX_MANAGER_INGRESS_HOST empty when the manager is exposed only by IP
# and the ingress should match requests without a host-specific rule.
SANDBOX_MANAGER_PUBLIC_BASE_URL=https://sandbox-manager.mbos.imotion.ai
# Optional internal base for compose-managed services reaching sandbox-manager.
# When unset, cluster-deploy falls back to SANDBOX_MANAGER_PUBLIC_BASE_URL.
COMPOSE_INTERNAL_SANDBOX_MANAGER_BASE_URL=
FULL_AUTO_INGRESS_NAMESPACE=ingress-nginx
FULL_AUTO_JUICEFS_NAMESPACE=juicefs-system
FULL_AUTO_INGRESS_SERVICE_TYPE=LoadBalancer
FULL_AUTO_INGRESS_HTTP_NODE_PORT=
FULL_AUTO_INGRESS_HTTPS_NODE_PORT=

# Namespace-only deploy line: this namespace must already exist.
INTERNAL_AGENT_K8S_NAMESPACE=mbos
INTERNAL_AGENT_JUICEFS_CSI_DRIVER=csi.juicefs.com
INTERNAL_AGENT_WORKSPACE_CAPACITY=1Pi
# Preinstalled storage class required. cluster-deploy does not install JuiceFS CSI.
INTERNAL_AGENT_JUICEFS_STORAGE_CLASS_NAME=juicefs-sc
INTERNAL_AGENT_JUICEFS_MOUNT_OPTIONS=writeback_cache
INTERNAL_AGENT_JUICEFS_SUBDIR=
INTERNAL_AGENT_JUICEFS_MOUNT_SERVICE_ACCOUNT=
INTERNAL_AGENT_JUICEFS_MOUNT_IMAGE=juicedata/mount:ce-v1.3.1
INTERNAL_AGENT_DEFAULT_CPU_REQUEST=1
INTERNAL_AGENT_DEFAULT_CPU_LIMIT=2
INTERNAL_AGENT_DEFAULT_MEMORY_REQUEST=2Gi
INTERNAL_AGENT_DEFAULT_MEMORY_LIMIT=4Gi
INTERNAL_AGENT_WORKLOAD_NODE_SELECTOR_JSON={"node":"mbos"}
INTERNAL_AGENT_WORKLOAD_TOLERATIONS_JSON=[{"key":"mbos","operator":"Exists","effect":"NoExecute"}]

SANDBOX_MANAGER_CPU_REQUEST=1
SANDBOX_MANAGER_CPU_LIMIT=2
SANDBOX_MANAGER_MEMORY_REQUEST=2Gi
SANDBOX_MANAGER_MEMORY_LIMIT=4Gi
SANDBOX_MANAGER_NODE_SELECTOR_JSON={"node":"mbos"}
SANDBOX_MANAGER_TOLERATIONS_JSON=[{"key":"mbos","operator":"Exists","effect":"NoExecute"}]

MBOS_AGENT_BUILTIN_SKILLS_DIR=/etc/codex/skills
MBOS_AGENT_JUICEFS_MOUNT_OPTIONS=
MBOS_AGENT_CODEX_YOLO=1

PRESET_ENDPOINT_API_KEY=
PRESET_ENDPOINT_MODEL=MiniMax-M2.7-highspeed
PRESET_ENDPOINT_MAX_CONTEXT_TOKENS=204800
PRESET_ENDPOINT_MAX_OUTPUT_TOKENS=128000
MBOS_ENDPOINT_PROXY_DEFAULT_TIMEOUT_SECONDS=600
PRESET_ENDPOINT_TIMEOUT_SECONDS=900
PRESET_ANTHROPIC_ENDPOINT_BASE_URL=https://api.minimaxi.com/anthropic/v1
PRESET_ANTHROPIC_ENDPOINT_PROTOCOL=anthropic_compatible
PRESET_OPENAI_ENDPOINT_BASE_URL=https://api.minimaxi.com/v1
PRESET_OPENAI_ENDPOINT_PROTOCOL=openai_compatible

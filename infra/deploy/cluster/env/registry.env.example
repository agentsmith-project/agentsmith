# Image registry used by cluster-deploy.
#
# For Harbor, fill REGISTRY_HOST with the registry host[:port] only.
# Examples:
#   REGISTRY_HOST=harbor.example.com
#   REGISTRY_HOST=harbor.example.com:8443
#
# REGISTRY_PROJECT must match the Harbor project/repository prefix that stores
# AgentSmith images. If Harbor uses project "agentsmith-prod", set:
#   REGISTRY_PROJECT=agentsmith-prod
#
# REGISTRY_USERNAME / REGISTRY_PASSWORD are used in two places:
# 1. publish-images.sh runs docker login + docker push on the deploy host
# 2. cluster-deploy creates imagePullSecrets so Kubernetes workloads can pull
#    the same images from the registry
#
# Leave REGISTRY_USERNAME and REGISTRY_PASSWORD empty only when the registry is
# truly anonymous for both push and pull. Most Harbor installs require both.
REGISTRY_HOST=imotion-cn-beijing.cr.volces.com
REGISTRY_PROJECT=mbos
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Registry host seen by Kubernetes nodes when they pull images.
#
# Leave empty when cluster nodes can reach the same host as REGISTRY_HOST.
# Set K8S_REGISTRY_HOST only when the deploy host pushes to one address but the
# cluster must pull from another address.
# Common cases:
# - same Harbor for push and pull:
#     REGISTRY_HOST=harbor.example.com
#     K8S_REGISTRY_HOST=
# - deploy host uses public Harbor hostname, cluster uses internal DNS name:
#     REGISTRY_HOST=harbor.example.com
#     K8S_REGISTRY_HOST=harbor.internal.svc.cluster.local
# - deploy host uses external port, cluster uses in-cluster service port:
#     REGISTRY_HOST=harbor.example.com:8443
#     K8S_REGISTRY_HOST=harbor-core.harbor.svc.cluster.local
K8S_REGISTRY_HOST=

# Optional base image mirrors for environments where Docker Hub / MCR is not directly reachable.
# Keep these aligned with the target host network policy.
APP_NODE_BASE_IMAGE=node:24.14.1-bookworm
RUNNER_NODE_BASE_IMAGE=node:24.14.1-bookworm
VERIFY_PLAYWRIGHT_BASE_IMAGE=mcr.microsoft.com/playwright:v1.58.1-noble
VERIFY_DOCKER_CLI_IMAGE=docker:28.5.1-cli
SANDBOX_GO_BASE_IMAGE=golang:1.25-alpine
SANDBOX_RUNTIME_BASE_IMAGE=ubuntu:22.04
UNIVERSAL_PROXY_RUST_BASE_IMAGE=rust:1.88-bookworm
UNIVERSAL_PROXY_RUNTIME_BASE_IMAGE=debian:bookworm-slim

FROM node:22-bookworm

ARG JUICEFS_VERSION=1.3.0
ARG CODEX_VERSION=0.110.0
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN set -eux; \
  if [ -n "${HTTP_PROXY:-}" ]; then echo "Acquire::http::Proxy \"${HTTP_PROXY}\";" > /etc/apt/apt.conf.d/99proxy; fi; \
  if [ -n "${HTTPS_PROXY:-}" ]; then echo "Acquire::https::Proxy \"${HTTPS_PROXY}\";" >> /etc/apt/apt.conf.d/99proxy; fi; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    fuse3 \
    git \
    openssh-client \
    procps \
    python3 \
    python3-pip \
    tini \
  ; \
  rm -f /etc/apt/apt.conf.d/99proxy; \
  rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  export http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" no_proxy="${NO_PROXY:-}"; \
  arch="$(dpkg --print-architecture)"; \
  case "${arch}" in \
    amd64) juicefs_arch="amd64" ;; \
    arm64) juicefs_arch="arm64" ;; \
    *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://github.com/juicedata/juicefs/releases/download/v${JUICEFS_VERSION}/juicefs-${JUICEFS_VERSION}-linux-${juicefs_arch}.tar.gz" -o /tmp/juicefs.tgz; \
  tar -xzf /tmp/juicefs.tgz -C /tmp; \
  install -m 0755 /tmp/juicefs /usr/local/bin/juicefs; \
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY no_proxy; \
  rm -rf /tmp/juicefs /tmp/juicefs.tgz

RUN set -eux; \
  export http_proxy="${HTTP_PROXY:-}" https_proxy="${HTTPS_PROXY:-}" HTTP_PROXY="${HTTP_PROXY:-}" HTTPS_PROXY="${HTTPS_PROXY:-}" NO_PROXY="${NO_PROXY:-}" no_proxy="${NO_PROXY:-}"; \
  npm install -g "@openai/codex@${CODEX_VERSION}"; \
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY no_proxy

WORKDIR /app

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "-lc", "npm run agent:codex-runner"]

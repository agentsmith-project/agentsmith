ARG APP_BASE_IMAGE=agentsmith-app-base:local
ARG NODE_RUNTIME_IMAGE=node:24.14.1-bookworm
ARG MC_IMAGE=minio/mc:latest

FROM ${MC_IMAGE} AS mc-bin

FROM ${APP_BASE_IMAGE} AS build

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY src ./src
COPY public ./public
COPY packages ./packages
COPY scripts ./scripts
COPY infra ./infra
COPY assets ./assets
COPY components.json ./
COPY next.config.ts ./
COPY next-env.d.ts ./
COPY postcss.config.js ./
COPY tailwind.config.js ./
COPY tsconfig.json ./

RUN --mount=type=cache,target=/app/.next/cache \
  npx next build --no-lint

RUN npm run api:node:build

FROM ${NODE_RUNTIME_IMAGE} AS runtime

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY --from=mc-bin /usr/bin/mc /usr/local/bin/mc

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  set -eux; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    procps \
  ;

COPY --from=build /app /app

EXPOSE 20000 3001

CMD ["bash", "-lc", "echo 'Use service-specific command overrides for api or web' && sleep infinity"]

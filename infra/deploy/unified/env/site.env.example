# AgentSmith deploy offline render example.
# Operators edit deploy configuration and Docker substrate truth, not generated manifests.

UNIFIED_DEPLOY_PROFILE=local-kind
NAMESPACE=agentsmith
INGRESS_CLASS_NAME=nginx
PUBLIC_BASE_URL=http://agentsmith.localtest.me:29180
PUBLIC_API_BASE_URL=http://agentsmith.localtest.me:29180/api/v1
RUNNER_PUBLIC_API_BASE_URL=ws://agentsmith.localtest.me:29180/api/v1
ASBCP_SERVICE_KEY=agentsmith_dev_asbcp_service_key
MBOS_UNIVERSAL_PROXY_ADMIN_TOKEN=agentsmith_dev_llmup_admin_token
AFSCP_DEFAULT_VOLUME_ID=vol_agentsmith_default
AFSCP_SERVICE_TOKEN=agentsmith_dev_afscp_product_token
AFSCP_BOOTSTRAP_SERVICE_TOKEN=agentsmith_dev_afscp_bootstrap_token
AFSCP_ORCHESTRATOR_SERVICE_TOKEN=agentsmith_dev_afscp_orchestrator_token

WEB_IMAGE=ghcr.io/mbos/agentsmith-app:dev
API_IMAGE=ghcr.io/mbos/agentsmith-app:dev
LLMUP_IMAGE=ghcr.io/mbos/llmup:dev
AFSCP_IMAGE=ghcr.io/agentsmith-project/agentsmith-fs-control-plane:v1.0.6@sha256:9ddeb916ed77f5a4ecd751b59488a017564c27392c62ed97f69c1dbec1e497f1
# Non-pullable placeholder for offline render examples; local-kind producer writes a real digest-pinned ASBCP image.
ASBCP_IMAGE=ghcr.io/agentsmith-project/agentsmith-sandbox-control-plane:v0.1.0@sha256:1111111111111111111111111111111111111111111111111111111111111111
MANAGED_RUNNER_IMAGE=ghcr.io/mbos/agentsmith-managed-runner:dev
INGRESS_NGINX_CONTROLLER_IMAGE=registry.k8s.io/ingress-nginx/controller:v1.15.1@sha256:594ceea76b01c592858f803f9ff4d2cb40542cae2060410b2c95f75907d659e1
INGRESS_NGINX_CERTGEN_IMAGE=registry.k8s.io/ingress-nginx/kube-webhook-certgen:v1.6.9@sha256:01038e7de14b78d702d2849c3aad72fd25903c4765af63cf16aa3398f5d5f2dd

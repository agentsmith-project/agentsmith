# Minimal real-lane upstream preset.

PRESET_ENDPOINT_API_KEY=
PRESET_ENDPOINT_BASE_URL=https://api.minimaxi.com/v1
PRESET_ENDPOINT_PROTOCOL=openai_compatible
PRESET_ENDPOINT_MODEL=MiniMax-M2.7-highspeed
PRESET_ENDPOINT_MAX_CONTEXT_TOKENS=204800
PRESET_ENDPOINT_MAX_OUTPUT_TOKENS=128000

# Derived aliases for direct Playwright / shell usage.
REAL_LANE_API_KEY=${PRESET_ENDPOINT_API_KEY}
REAL_LANE_BASE_URL=${PRESET_ENDPOINT_BASE_URL}
REAL_LANE_PROTOCOL=${PRESET_ENDPOINT_PROTOCOL}
REAL_LANE_MODEL=${PRESET_ENDPOINT_MODEL}
REAL_LANE_ANTHROPIC_BASE_URL=${PRESET_ENDPOINT_BASE_URL}
REAL_LANE_OPENAI_BASE_URL=${PRESET_ENDPOINT_BASE_URL}

SANDBOX_MANAGER_URL=http://127.0.0.1:28080
SANDBOX_SERVICE_KEY=agentsmith-internal-test-key
LOCAL_MANUAL_INTERNAL_AGENT_IMAGE=agentsmith-agent-task-runner:local
LOCAL_MANUAL_INTERNAL_AGENT_BASE_IMAGE=agentsmith-agent-task-runner-base:local
INTERNAL_AGENT_KIND_CLUSTER_NAME=agentsmith
INTERNAL_AGENT_K8S_NAMESPACE=agentsmith-sandbox
# AFSCP is started as a local-real dependency for development/test deploy only;
# production/business deployment remains the Kubernetes AFSCP deployment.
AFSCP_BASE_URL=http://127.0.0.1:28090
AFSCP_EXPORT_GATEWAY_BASE_URL=http://127.0.0.1:28091
AFSCP_CALLER_SERVICE=agentsmith-api
AFSCP_BOOTSTRAP_CALLER_SERVICE=agentsmith-bootstrap
AFSCP_DEFAULT_VOLUME_ID=vol_local_manual
# JVS release URLs are local development/test dependency config. AgentSmith
# verifies binary consistency through SHA256SUMS; AFSCP owns the accepted pin.
AFSCP_JVS_RELEASE_URL=https://github.com/agentsmith-project/jvs/releases/download/v0.4.9/jvs-linux-amd64
AFSCP_JVS_SHA256SUMS_URL=https://github.com/agentsmith-project/jvs/releases/download/v0.4.9/SHA256SUMS
# Direct restore is still a pre-GA JVS artifact, but Files restore stories use
# the direct restore AFSCP route. Keep this explicit so the local-real profile
# does not silently admit restore without a verified direct-capable binary.
AFSCP_JVS_BINARY_PATH=${AFSCP_JVS_BINARY_PATH:-${ROOT_DIR}/../jvs/bin/jvs-direct-restore}
AFSCP_JVS_BINARY_SHA256=${AFSCP_JVS_BINARY_SHA256:-c88553bb18bdd70e1399bf562fcb853bd200798498bd24bc25458196fb568902}
AFSCP_RESTORE_RECOVERY_ENABLED=${AFSCP_RESTORE_RECOVERY_ENABLED:-true}
AFSCP_JVS_DIRECT_RESTORE_BINARY_SHA256=${AFSCP_JVS_DIRECT_RESTORE_BINARY_SHA256:-c88553bb18bdd70e1399bf562fcb853bd200798498bd24bc25458196fb568902}
AFSCP_JVS_DIRECT_RESTORE_SOURCE_REF=${AFSCP_JVS_DIRECT_RESTORE_SOURCE_REF:-jvs@c65b418f58d6e39e91199c1d55783e2ec91be9a1}
# File Library product profile: save points, restore, and task file templates
# must be available in local-real unless explicitly overridden for a negative test.
AFSCP_REPO_TEMPLATE_ENABLED=true
AFSCP_REPO_TEMPLATE_READY=true
AFSCP_SAVE_POINT_RECOVERY_ENABLED=true
AFSCP_TEMPLATE_CREATE_RECOVERY_ENABLED=true
AFSCP_TEMPLATE_CLONE_RECOVERY_ENABLED=true
AFSCP_RESTORE_PREVIEW_RECOVERY_ENABLED=true
AFSCP_RESTORE_PREVIEW_DISCARD_RECOVERY_ENABLED=true
AFSCP_RESTORE_RUN_RECOVERY_ENABLED=true
AFSCP_SERVICE_TOKEN=agentsmith-local-afscp-product-token
AFSCP_BOOTSTRAP_SERVICE_TOKEN=agentsmith-local-afscp-bootstrap-token
AFSCP_ORCHESTRATOR_CALLER_SERVICE=agentsmith-sandbox-manager
AFSCP_ORCHESTRATOR_SERVICE_TOKEN=agentsmith-local-afscp-orchestrator-token

# Secrets and optional overrides for `make local-manual-*`.
#
# Recommended local-manual app port overrides when another current runtime line
# is already using the default app ports:
# PORT_API=21000
# PORT_WEB=3101
# PROXY_PORT=39080
#
# Optional safety valve:
# LOCAL_MANUAL_ALLOW_UNTRACKED_PORT_CLEANUP=0

LOCAL_MANUAL_ALLOW_UNTRACKED_PORT_CLEANUP=0

PRESET_ENDPOINT_API_KEY=
PRESET_ENDPOINT_MODEL=deepseek-v4-flash
PRESET_ENDPOINT_MAX_CONTEXT_TOKENS=204800
PRESET_ENDPOINT_MAX_OUTPUT_TOKENS=128000
PRESET_ANTHROPIC_ENDPOINT_BASE_URL=https://api.deepseek.com/anthropic
PRESET_ANTHROPIC_ENDPOINT_PROTOCOL=anthropic_messages
PRESET_OPENAI_ENDPOINT_BASE_URL=https://api.deepseek.com
PRESET_OPENAI_ENDPOINT_PROTOCOL=openai_chat_completions

# Optional local-manual app port overrides.
# PORT_API=21000
# PORT_WEB=3101
# PROXY_PORT=39080

# AFSCP JVS: usually do not set AFSCP_JVS_BINARY_PATH/SHA.
# local-real downloads the verified GitHub release artifact declared by
# AFSCP_JVS_RELEASE_VERSION and caches it under artifacts/cache/jvs-release.
# Explicit binary overrides are diagnostics only and must pass `jvs afscp --help`.
# Do not pin the historical sibling build output ../jvs/bin/jvs-linux-amd64.
# AFSCP_JVS_RELEASE_VERSION=v0.4.10
# AFSCP_JVS_BINARY_PATH=/path/to/direct-capable/jvs
# AFSCP_JVS_BINARY_SHA256=

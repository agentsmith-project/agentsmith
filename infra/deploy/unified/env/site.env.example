# AgentSmith deploy offline render example.
# Operators edit deploy configuration and Docker substrate truth, not generated manifests.

UNIFIED_DEPLOY_PROFILE=local-kind
NAMESPACE=agentsmith
INGRESS_CLASS_NAME=nginx
PUBLIC_BASE_URL=http://agentsmith.localtest.me:29180
PUBLIC_API_BASE_URL=http://agentsmith.localtest.me:29180/api/v1
RUNNER_PUBLIC_API_BASE_URL=ws://agentsmith.localtest.me:29180/api/v1
SYSTEM_ADMIN_USERNAME=mbos-admin
AFSCP_DEFAULT_VOLUME_ID=vol_agentsmith_default
AGENTSMITH_APP_REF=agentsmith-app-secrets
AGENTSMITH_APP_REF_REVISION=stable
AFSCP_RUNTIME_REF=afscp-runtime-secrets
AFSCP_RUNTIME_REF_REVISION=stable
AFSCP_VOLUME_REF=afscp-default-volume-juicefs
AFSCP_VOLUME_REF_REVISION=stable

WEB_IMAGE=ghcr.io/agentsmith-project/agentsmith-app:example@sha256:1111111111111111111111111111111111111111111111111111111111111111
API_IMAGE=ghcr.io/agentsmith-project/agentsmith-app:example@sha256:1111111111111111111111111111111111111111111111111111111111111111
LLMUP_IMAGE=ghcr.io/agentsmith-project/llm-universal-proxy:v0.2.44@sha256:187394a51950148d696edd5e2d558d835d4238415060b2d5f6a23ea58e620976
AFSCP_IMAGE=ghcr.io/agentsmith-project/agentsmith-fs-control-plane:v1.0.30@sha256:5326a9a54a9fa67f27dc0983a4e7955044a03d67676f682812894daaf83d860e
# Blank uses infra/deploy/shared/asbcp-image.lock for offline render examples.
ASBCP_IMAGE=
# Replace with the released digest-pinned managed runner image.
MANAGED_RUNNER_IMAGE=ghcr.io/agentsmith-project/agentsmith-managed-runner:example@sha256:2222222222222222222222222222222222222222222222222222222222222222
INGRESS_NGINX_CONTROLLER_IMAGE=registry.k8s.io/ingress-nginx/controller:v1.15.1@sha256:594ceea76b01c592858f803f9ff4d2cb40542cae2060410b2c95f75907d659e1
INGRESS_NGINX_CERTGEN_IMAGE=registry.k8s.io/ingress-nginx/kube-webhook-certgen:v1.6.9@sha256:01038e7de14b78d702d2849c3aad72fd25903c4765af63cf16aa3398f5d5f2dd

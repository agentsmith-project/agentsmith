FROM agentsmith-deploy:d0a7aae

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  set -eux; \
  if [ -n "${HTTP_PROXY:-}" ]; then echo "Acquire::http::Proxy \"${HTTP_PROXY}\";" > /etc/apt/apt.conf.d/99proxy; fi; \
  if [ -n "${HTTPS_PROXY:-}" ]; then echo "Acquire::https::Proxy \"${HTTPS_PROXY}\";" >> /etc/apt/apt.conf.d/99proxy; fi; \
  apt-get update; \
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl wget git openssh-client \
    build-essential pkg-config \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
    libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev \
    fonts-noto-cjk fonts-wqy-zenhei fonts-wqy-microhei \
  ;

RUN --mount=type=cache,target=/root/.cache/pip \
  --mount=type=cache,target=/root/.cache/python-src \
  set -eux; \
  archive_cache="/root/.cache/python-src/Python-3.12.8.tgz"; \
  if [ ! -f "${archive_cache}" ]; then \
    wget -O "${archive_cache}" https://www.python.org/ftp/python/3.12.8/Python-3.12.8.tgz; \
  fi; \
  rm -rf /tmp/Python-3.12.8; \
  mkdir -p /tmp/Python-3.12.8-src; \
  tar -xzf "${archive_cache}" -C /tmp/Python-3.12.8-src; \
  cd /tmp/Python-3.12.8-src/Python-3.12.8; \
  ./configure --prefix=/opt/python312 --enable-optimizations --with-ensurepip=install; \
  make -j"$(nproc)"; \
  make altinstall; \
  ln -sf /opt/python312/bin/python3.12 /usr/local/bin/python3.12; \
  ln -sf /opt/python312/bin/pip3.12 /usr/local/bin/pip3.12; \
  python3.12 -m pip install --upgrade pip setuptools wheel; \
  python3.12 -m pip install \
    numpy pandas scipy matplotlib scikit-learn seaborn jupyterlab; \
  rm -rf /tmp/Python-3.12.8-src;

RUN --mount=type=cache,target=/root/.npm \
  npm install -g @openai/codex@0.110.0

RUN set -eux; \
  rm -f /etc/apt/apt.conf.d/99proxy; \
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY || true

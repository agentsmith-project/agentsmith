{
  "name": "agentsmith",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/run-next-dev-safe.sh --turbopack",
    "dev:test": "bash scripts/run-next-dev-safe.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs",
    "test:ui": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs --ui",
    "test:run": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run --coverage",
    "test:integration": "bash scripts/integration-test.sh",
    "test:e2e": "playwright test --project=smoke --project=chromium --project=chromium-serial",
    "test:e2e:all": "playwright test",
    "test:e2e:lane:mock:smoke": "playwright test --project=smoke",
    "test:e2e:lane:mock:chromium": "playwright test --project=chromium --project=chromium-serial",
    "test:e2e:lane:mock:visual": "playwright test --project=visual",
    "test:e2e:lane:mock:visual:update": "playwright test --project=visual --update-snapshots",
    "test:visual:strict": "bash scripts/run-mock-lane-playwright.sh e2e/visual.spec.ts --project=visual --workers=1",
    "test:e2e:lane:mock:full": "playwright test --project=smoke --project=chromium --project=chromium-serial",
    "test:e2e:lane:mock:full:with-visual": "bash scripts/run-mock-lane-playwright.sh --project=smoke --workers=1 && bash scripts/run-mock-lane-playwright.sh --project=chromium --workers=4 && bash scripts/run-mock-lane-playwright.sh --project=chromium-serial --workers=1 && bash scripts/run-mock-lane-playwright.sh --project=visual --workers=1",
    "test:e2e:lane:real": "playwright test --config playwright.config.integration.ts --project=chromium",
    "test:e2e:integration:minimal": "playwright test --config playwright.config.integration.ts e2e/integration-minimal.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:files": "playwright test --config playwright.config.integration.ts e2e/integration-files.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:chat": "playwright test --config playwright.config.integration.ts e2e/integration-chat.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:agents": "playwright test --config playwright.config.integration.ts e2e/integration-agents-external.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:agents:codex": "playwright test --config playwright.config.integration.ts e2e/integration-agents-codex-runner.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:endpoints-capabilities": "playwright test --config playwright.config.integration.ts e2e/integration-endpoint-capabilities.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:notebook:codex": "playwright test --config playwright.config.integration.ts e2e/integration-notebook-codex-runner.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:notebook:codex:docker": "playwright test --config playwright.config.integration.ts e2e/integration-notebook-codex-runner.spec.ts --project=chromium --workers=1 --grep docker",
    "test:e2e:integration:files:mount-sync": "playwright test --config playwright.config.integration.ts e2e/integration-files-mount-sync.spec.ts --project=chromium --workers=1",
    "test:e2e:integration:chat:real": "INTEGRATION_REAL_COMPLETION_E2E=true playwright test --config playwright.config.integration.ts e2e/integration-chat.spec.ts --project=chromium --workers=1 --grep \"real deepseek\"",
    "test:e2e:integration:minimal:with-api": "bash scripts/run-integration-e2e-with-api.sh e2e/integration-minimal.spec.ts",
    "test:e2e:integration:files:with-api": "bash scripts/run-integration-e2e-with-api.sh e2e/integration-files.spec.ts",
    "test:e2e:integration:chat:with-api": "bash scripts/run-integration-e2e-with-api.sh e2e/integration-chat.spec.ts",
    "test:e2e:integration:agents:with-api": "bash scripts/run-integration-e2e-with-api.sh e2e/integration-agents-external.spec.ts",
    "test:e2e:integration:notebook-external:with-api": "bash scripts/run-integration-e2e-with-api.sh e2e/integration-notebook-external.spec.ts",
    "test:e2e:integration:endpoints-capabilities:with-api": "bash scripts/run-integration-e2e-with-api.sh e2e/integration-endpoint-capabilities.spec.ts",
    "test:e2e:integration:chat:real:with-api": "INTEGRATION_REAL_COMPLETION_E2E=true bash scripts/run-integration-e2e-with-api.sh e2e/integration-chat.spec.ts --grep \"real deepseek\"",
    "test:mainline:strict": "bash scripts/workspace-project-mainline-gate.sh",
    "test:mainline:strict:real": "bash scripts/workspace-project-mainline-gate.sh --with-real-lane",
    "test:governance:strict": "bash scripts/governance-mainline-gate.sh",
    "test:members-governance:strict": "bash scripts/governance-mainline-gate.sh",
    "test:smoke:real:notebook-mainline": "bash scripts/system-notebook-real-smoke-gate.sh",
    "test:internal:real:notebook-workspace": "bash scripts/run-internal-notebook-real-gate.sh",
    "test:agents:real:codex": "bash scripts/run-integration-e2e-full.sh e2e/integration-agents-codex-runner.spec.ts && bash scripts/run-integration-e2e-full.sh e2e/integration-notebook-codex-runner.spec.ts && bash scripts/run-integration-e2e-full.sh e2e/integration-notebook-codex-runner.spec.ts --grep docker",
    "test:files:real:smoke": "bash scripts/file-library-real-smoke.sh",
    "test:files:real:sync": "bash scripts/file-library-mount-sync-smoke.sh",
    "test:files:real:ui-sync": "bash scripts/run-integration-e2e-full.sh e2e/integration-files-mount-sync.spec.ts",
    "test:files:release:strict": "bash scripts/run-mock-lane-playwright.sh e2e/files.spec.ts --project=chromium --workers=1 && bash scripts/run-mock-lane-playwright.sh e2e/visual.spec.ts --project=visual --workers=1 --grep 'Visual - Project Pages › files$|files - create folder dialog|files - rename dialog|files - selection with details panel|files - mount access dialog|files - create library dialog|files - delete non-empty library dialog' && bash scripts/run-file-library-real-gate.sh",
    "test:visual:real:review": "bash scripts/release-real-visual-review.sh",
    "gate:fast": "npm run contracts:check && npx tsc --noEmit && npm run test:e2e:lane:mock:smoke",
    "gate:main": "npm run test:mainline:strict && npm run test:governance:strict && npm run test:visual:strict",
    "gate:release": "bash scripts/release-real-full-gate.sh",
    "lane:mock": "npm run test:e2e:lane:mock:full",
    "lane:visual": "npm run test:visual:strict",
    "lane:real:core": "bash scripts/release-real-run.sh",
    "lane:real:release": "bash scripts/release-real-full-gate.sh",
    "manual:feishu:admin": "bash scripts/manual-feishu-admin.sh",
    "manual:feishu:user": "bash scripts/manual-feishu-user.sh",
    "manual:feishu:check": "bash scripts/manual-feishu-check.sh",
    "release:real:reset": "bash scripts/release-real-reset.sh",
    "release:real:bootstrap": "bash scripts/release-real-bootstrap.sh",
    "release:real:ready": "bash scripts/wait-real-stack-ready.sh",
    "release:real:run": "bash scripts/release-real-run.sh",
    "release:real:report": "bash scripts/release-real-report.sh",
    "docs:artifacts:generate": "bash scripts/generate-doc-artifacts.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "integration:deps:up": "docker compose -f infra/integration/docker-compose.yml up -d",
    "integration:deps:up:env": "docker compose --env-file infra/integration/.env -f infra/integration/docker-compose.yml up -d",
    "integration:deps:down": "docker compose -f infra/integration/docker-compose.yml down",
    "integration:deps:down:volumes": "docker compose -f infra/integration/docker-compose.yml down -v",
    "integration:deps:logs": "docker compose -f infra/integration/docker-compose.yml logs -f --tail=200",
    "integration:deps:ps": "docker compose -f infra/integration/docker-compose.yml ps",
    "integration:deps:init:postgres": "bash scripts/integration-db-init.sh",
    "integration:deps:init:keycloak": "tsx scripts/integration-keycloak-init.ts",
    "integration:deps:smoke": "tsx scripts/integration-deps-smoke.ts",
    "integration:test:adapters": "npm run test -w @mbos/adapters-private",
    "api:node:dev:pg": "DATABASE_URL=postgresql://mbos:mbos_dev_password@localhost:15432/mbos npm run api:node:dev",
    "contracts:check-limit-naming": "tsx scripts/contracts/check-limit-naming-boundary.ts",
    "contracts:check": "npm run contracts:check-limit-naming && tsx scripts/contracts/check-permission-gates.ts",
    "contracts:check-doc-governance": "tsx scripts/contracts/check-doc-governance.ts",
    "contracts:check-openapi-core": "tsx scripts/contracts/check-openapi-core-coverage.ts",
    "contracts:check-openapi-route-kinds": "tsx scripts/contracts/check-openapi-route-kind-coverage.ts",
    "contracts:check-openapi-breaking": "tsx scripts/contracts/check-openapi-breaking.ts",
    "contracts:check-openapi": "npm run contracts:check-openapi-core && npm run contracts:check-openapi-route-kinds && npm run contracts:check-openapi-breaking",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "openapi:sync-json": "tsx scripts/openapi/generate-json.ts",
    "openapi:generate": "tsx scripts/openapi/generate-types.ts",
    "openapi:check-generated": "tsx scripts/openapi/check-generated.ts",
    "openapi:changelog": "tsx scripts/openapi/generate-changelog.ts",
    "governance:report": "node --import tsx scripts/governance/verify-governance-report.ts",
    "models:sync-catalog": "tsx scripts/models/sync-catalog.ts",
    "agent:test-runner": "tsx packages/api-entry-node/examples/external-agent-test-runner.ts",
    "agent:codex-runner": "npm run dev -w @mbos/agent-codex-runner",
    "api:node:dev": "npm run dev -w @mbos/api-entry-node",
    "ws:typecheck": "npm run --workspaces typecheck --if-present",
    "ws:build": "npm run --workspaces build --if-present",
    "ws:test": "npm run --workspaces test --if-present",
    "contracts:check-engineering-sync": "npm run contracts:check-doc-governance"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@swc/helpers": "^0.5.19",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.563.0",
    "next": "15.5.12",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.7.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-themes": "^8.0.0",
    "@storybook/nextjs": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.12",
    "jsdom": "^28.0.0",
    "msw": "^2.0.0",
    "msw-storybook-addon": "^2.0.0",
    "openapi-diff": "^0.24.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.0",
    "storybook": "^8.0.0",
    "swagger-ui-dist": "^5.31.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  }
}

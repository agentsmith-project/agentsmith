{
  "name": "mbos-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:test": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "bash scripts/integration-test.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "integration:deps:up": "docker compose -f infra/integration/docker-compose.yml up -d",
    "integration:deps:up:env": "docker compose --env-file infra/integration/.env -f infra/integration/docker-compose.yml up -d",
    "integration:deps:down": "docker compose -f infra/integration/docker-compose.yml down",
    "integration:deps:down:volumes": "docker compose -f infra/integration/docker-compose.yml down -v",
    "integration:deps:logs": "docker compose -f infra/integration/docker-compose.yml logs -f --tail=200",
    "integration:deps:ps": "docker compose -f infra/integration/docker-compose.yml ps",
    "integration:deps:init:postgres": "bash scripts/integration-db-init.sh",
    "integration:deps:smoke": "tsx scripts/integration-deps-smoke.ts",
    "integration:test:adapters": "npm run test -w @mbos/adapters-private",
    "api:node:dev:pg": "DATABASE_URL=postgresql://mbos:mbos_dev_password@localhost:15432/mbos npm run api:node:dev",
    "contracts:check": "tsx scripts/contracts/check-permission-gates.ts",
    "contracts:check-release-sync": "tsx scripts/contracts/check-release-sync.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "openapi:generate": "tsx scripts/openapi/generate-types.ts",
    "api:node:dev": "npm run dev -w @mbos/api-entry-node",
    "ws:typecheck": "npm run --workspaces typecheck --if-present",
    "ws:build": "npm run --workspaces build --if-present",
    "ws:test": "npm run --workspaces test --if-present"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.563.0",
    "next": "15.5.12",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-themes": "^8.0.0",
    "@storybook/nextjs": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.12",
    "jsdom": "^28.0.0",
    "msw": "^2.0.0",
    "msw-storybook-addon": "^2.0.0",
    "postcss": "^8.4.0",
    "storybook": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

# MBOS Frontend Environment Variables

# ============================================================
# API Configuration
# ============================================================

# Backend API Base URL (development, include /api/v1)
NEXT_PUBLIC_API_BASE=http://localhost:20000/api/v1

# Use MSW for API mocking
# - true: mock mode
# - false: real Keycloak + API mode
NEXT_PUBLIC_USE_MSW=false

# Enable hybrid sources read path:
# - true: sources list tries real backend first, then falls back to current adapter on failure
# - false: keep current adapter behavior only
NEXT_PUBLIC_SOURCES_REAL_READ_ENABLED=true

# Enable hybrid sources write path:
# - true: sources upload/delete try real backend first, then fall back to current adapter
# - false: keep current adapter behavior only
NEXT_PUBLIC_SOURCES_REAL_WRITE_ENABLED=true

# Real backend base for hybrid sources read (must include /api/v1)
# Example: http://localhost:3022/api/v1
NEXT_PUBLIC_SOURCES_REAL_BASE=http://localhost:20000/api/v1

# Bypass authentication (development only - for testing)
NEXT_PUBLIC_BYPASS_AUTH=false

# ============================================================
# i18n Configuration
# ============================================================

# Default locale (fallback if user locale not available)
NEXT_PUBLIC_DEFAULT_LOCALE=en-US

# Supported locales
NEXT_PUBLIC_LOCALES=en-US,zh-CN

# ============================================================
# Keycloak OIDC (Production)
# ============================================================

# Keycloak server URL
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:18080/realms

# Keycloak realm
NEXT_PUBLIC_KEYCLOAK_REALM=mbos

# Keycloak client ID
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=mbos-frontend

# ============================================================
# Feature Flags
# ============================================================

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# Enable service worker (PWA)
NEXT_PUBLIC_SERVICE_WORKER=false

#
# This is the only deployment config file operators should edit.
# Generated service env files are derived from this file and must not be edited directly.
#
# Public URLs are for browsers and redirects.
# Compose internal URLs are for container-to-container traffic inside Compose.
# Host-local values are only for host-machine verification and local maintenance on the deployed server.
# Client-public file-library values are what end users use from their own machines when mounting JuiceFS locally.
# Runner execution addresses, sandbox URLs, and kind gateway addresses are resolved automatically at deploy time.
# All runner modes share the same schema:
# - dev_direct external runner reads this schema through scripts/run-external-runner-dev.sh
# - docker_manual external runner uses the same rendered runtime truth
# - compose_managed external runner and k8s_internal runner derive their execution truth from the same role inputs
#
POSTGRES_USER=mbos
POSTGRES_PASSWORD=mbos_dev_password
POSTGRES_DB=mbos
POSTGRES_PORT=15432

MONGO_ROOT_USERNAME=mbos
MONGO_ROOT_PASSWORD=mbos_dev_password
MONGO_DB=mbos
MONGO_PORT=17017

REDIS_PORT=16379

MINIO_ROOT_USER=mbos
MINIO_ROOT_PASSWORD=mbos_dev_password
MINIO_BUCKET=mbos-dev
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_PORT=18080
KEYCLOAK_REALM=mbos
KEYCLOAK_CLIENT_ID=agentsmith

PUBLIC_WEB_BASE_URL=http://localhost:3001
PUBLIC_API_BASE_URL=http://localhost:20000
PUBLIC_KEYCLOAK_BASE_URL=http://localhost:18080
COMPOSE_INTERNAL_API_BASE_URL=http://api:20000
COMPOSE_INTERNAL_KEYCLOAK_BASE_URL=http://keycloak:8080
COMPOSE_INTERNAL_UNIVERSAL_PROXY_BASE_URL=http://universal-proxy:8080
HOST_LOCAL_POSTGRES_HOST=localhost
HOST_LOCAL_POSTGRES_PORT=15432
HOST_LOCAL_MINIO_ENDPOINT=http://localhost:19000
CLIENT_PUBLIC_POSTGRES_HOST=localhost
CLIENT_PUBLIC_POSTGRES_PORT=15432
CLIENT_PUBLIC_MINIO_ENDPOINT=http://localhost:19000
EXTERNAL_DEPS_NETWORK_NAME=agentsmith-demo-deps
EXTERNAL_DEPS_NETWORK_SUBNET=172.29.0.0/24
EXTERNAL_DEPS_POSTGRES_IP=172.29.0.10
EXTERNAL_DEPS_MINIO_IP=172.29.0.11

API_PORT=20000
WEB_PORT=3001

SYSTEM_ADMIN_USERNAME=mbos-admin
SYSTEM_ADMIN_PASSWORD=mbos-admin
SYSTEM_ADMIN_SESSION_COOKIE_SECURE=false

INTEGRATION_PUBLIC_WEB_BASES=http://localhost:3001
INTEGRATION_DEV_ADMIN_USERNAME=dev-admin
INTEGRATION_DEV_ADMIN_PASSWORD=dev-admin-123
INTEGRATION_USER_USERNAME=integration-user
INTEGRATION_USER_PASSWORD=integration-user-123
INTEGRATION_MEMBER_USERNAME=integration-member
INTEGRATION_MEMBER_PASSWORD=integration-member-123

MBOS_DEFAULT_WORKSPACE_ID=ws_default
MBOS_DEFAULT_WORKSPACE_NAME="Default Workspace"
MBOS_DEFAULT_WORKSPACE_ADMIN_EMAIL=dev-admin@example.com
PRESET_PROJECT_NAME="Demo Project"
PRESET_CREDENTIAL_NAME=minimax-shared-key
PRESET_PRIMARY_ENDPOINT_NAME=minimax-shared-primary
PRESET_SECONDARY_ENDPOINT_NAME=minimax-shared-secondary
PRESET_EXTERNAL_AGENT_NAME=demo-external-agent
PRESET_INTERNAL_AGENT_NAME=demo-internal-agent

SYSTEM_WORKSPACE_REGISTRY_MODE=mongo

SANDBOX_SERVICE_KEY=agentsmith-sandbox-key
SANDBOX_HOST_PORT=29080

INTERNAL_AGENT_K8S_NAMESPACE=agentsmith-sandbox
INTERNAL_AGENT_JUICEFS_CSI_DRIVER=csi.juicefs.com
INTERNAL_AGENT_WORKSPACE_CAPACITY=1Pi
INTERNAL_AGENT_JUICEFS_STORAGE_CLASS_NAME=
INTERNAL_AGENT_JUICEFS_MOUNT_OPTIONS=writeback_cache
INTERNAL_AGENT_JUICEFS_SUBDIR=
INTERNAL_AGENT_JUICEFS_MOUNT_SERVICE_ACCOUNT=
INTERNAL_AGENT_JUICEFS_MOUNT_IMAGE=juicedata/mount:ce-v1.3.1

MBOS_AGENT_BUILTIN_SKILLS_DIR=/opt/agent-runner/builtin-skills
MBOS_AGENT_JUICEFS_MOUNT_OPTIONS=
MBOS_AGENT_CODEX_YOLO=1

PRESET_ENDPOINT_API_KEY=
PRESET_ENDPOINT_BASE_URL=https://api.minimaxi.com/v1
PRESET_ENDPOINT_MODEL=MiniMax-M2.7-highspeed
PRESET_ENDPOINT_PROTOCOL=openai_compatible
PRESET_ENDPOINT_MAX_CONTEXT_TOKENS=204800
PRESET_ENDPOINT_MAX_OUTPUT_TOKENS=128000
MBOS_ENDPOINT_PROXY_DEFAULT_TIMEOUT_SECONDS=600
PRESET_ENDPOINT_TIMEOUT_SECONDS=900
